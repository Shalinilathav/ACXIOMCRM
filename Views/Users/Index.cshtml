@model IEnumerable<AcxiomCRM.Models.ViewModels.UserManagementViewModel>
@{
    ViewData["Title"] = "User Management";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="fw-bold text-primary mb-0"><i class="bi bi-people me-2"></i>User Management</h2>
            <span class="badge bg-warning text-dark ms-1"><i class="bi bi-shield-lock me-1"></i>Admin Only</span>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-person-plus me-1"></i>Create User
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Search -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label fw-semibold">Search by Name or Email</label>
                    <input type="text" name="search" class="form-control"
                           placeholder="Enter name or email..."
                           value="@Context.Request.Query["search"]" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Role</label>
                    <select name="role" class="form-select">
                        <option value="">-- All Roles --</option>
                        <option value="Admin" selected="@(Context.Request.Query["role"] == "Admin" ? "selected" : null)">Admin</option>
                        <option value="Manager" selected="@(Context.Request.Query["role"] == "Manager" ? "selected" : null)">Manager</option>
                        <option value="SalesExecutive" selected="@(Context.Request.Query["role"] == "SalesExecutive" ? "selected" : null)">Sales Executive</option>
                    </select>
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search me-1"></i>Search
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary w-100">
                        <i class="bi bi-x-lg"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Table -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-people fs-1"></i>
                    <p class="mt-2">No users found.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Full Name</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Status</th>
                                <th>Lock Status</th>
                                <th>Last Login</th>
                                <th>Created</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2"
                                                 style="width:36px;height:36px;font-size:14px;font-weight:bold;">
                                                @user.FullName?.Substring(0, 1).ToUpper()
                                            </div>
                                            <strong>@user.FullName</strong>
                                        </div>
                                    </td>
                                    <td>@user.Email</td>
                                    <td>
                                        @{
                                            string roleBadge = user.Role switch
                                            {
                                                "Admin" => "bg-danger",
                                                "Manager" => "bg-warning text-dark",
                                                "SalesExecutive" => "bg-info text-dark",
                                                _ => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @roleBadge">@user.Role</span>
                                    </td>
                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        @if (user.IsLockedOut)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                <i class="bi bi-lock-fill me-1"></i>Locked
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border">
                                                <i class="bi bi-unlock me-1"></i>Unlocked
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @(user.LastLoginDate.HasValue ? user.LastLoginDate.Value.ToString("dd MMM yyyy") : "Never")
                                    </td>
                                    <td>@user.CreatedDate.ToString("dd MMM yyyy")</td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-1 flex-wrap">
                                            <a asp-action="Edit" asp-route-id="@user.UserId"
                                               class="btn btn-sm btn-outline-warning" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form asp-action="ToggleLock" asp-route-id="@user.UserId" method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm @(user.IsLockedOut ? "btn-outline-success" : "btn-outline-warning")"
                                                        title="@(user.IsLockedOut ? "Unlock" : "Lock")">
                                                    <i class="bi @(user.IsLockedOut ? "bi-unlock" : "bi-lock")"></i>
                                                </button>
                                            </form>
                                            <a asp-action="ResetPassword" asp-route-id="@user.UserId"
                                               class="btn btn-sm btn-outline-info" title="Reset Password">
                                                <i class="bi bi-key"></i>
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@user.UserId" method="post"
                                                  onsubmit="return confirm('Are you sure you want to delete user @user.FullName?')">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="p-3 text-muted small">Total: @Model.Count() user(s)</div>
            }
        </div>
    </div>
</div>
