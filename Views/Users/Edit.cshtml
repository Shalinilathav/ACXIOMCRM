@model AcxiomCRM.Models.ViewModels.CreateUserViewModel
@{
    ViewData["Title"] = "Edit User";
}

<div class="container-fluid px-4">
    <div class="d-flex align-items-center mb-3">
        <a asp-action="Index" class="btn btn-outline-secondary me-3">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h2 class="fw-bold text-warning mb-0"><i class="bi bi-person-gear me-2"></i>Edit User</h2>
    </div>

    <div class="card shadow-sm" style="max-width: 600px;">
        <div class="card-header bg-light">
            <div class="alert alert-info mb-0 py-2">
                <i class="bi bi-info-circle me-2"></i>
                To reset the user's password, use the <strong>Reset Password</strong> action on the user list.
            </div>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="FullName" class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
                        <input asp-for="FullName" class="form-control" placeholder="Enter full name..." />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Email" class="form-label fw-semibold">Email</label>
                        <input asp-for="Email" type="email" class="form-control bg-light" readonly />
                        <small class="text-muted">Email cannot be changed.</small>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Role" class="form-label fw-semibold">Role <span class="text-danger">*</span></label>
                        <select asp-for="Role" class="form-select">
                            <option value="">-- Select Role --</option>
                            <option value="Admin">Admin</option>
                            <option value="Manager">Manager</option>
                            <option value="SalesExecutive">Sales Executive</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 d-flex align-items-end">
                        <div class="form-check mb-2">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label asp-for="IsActive" class="form-check-label fw-semibold">Active User</label>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-save me-1"></i>Save Changes
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
