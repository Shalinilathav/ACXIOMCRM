@model IEnumerable<AcxiomCRM.Models.Customer>
@{
    ViewData["Title"] = "Customer Report";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold text-primary"><i class="bi bi-file-earmark-person me-2"></i>Customer Report</h2>
        <div class="d-flex gap-2">
            <a href="javascript:window.print()" class="btn btn-outline-secondary">
                <i class="bi bi-printer me-1"></i>Print
            </a>
        </div>
    </div>

    <!-- Filters -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" asp-action="CustomerReport" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Status</label>
                    <select name="status" class="form-select">
                        <option value="">-- All Statuses --</option>
                        <option value="Active" selected="@(Context.Request.Query["status"] == "Active" ? "selected" : null)">Active</option>
                        <option value="Inactive" selected="@(Context.Request.Query["status"] == "Inactive" ? "selected" : null)">Inactive</option>
                        <option value="Prospect" selected="@(Context.Request.Query["status"] == "Prospect" ? "selected" : null)">Prospect</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Assigned To</label>
                    <input type="text" name="assignedTo" class="form-control" placeholder="Filter by assigned user..."
                           value="@Context.Request.Query["assignedTo"]" />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold">From Date</label>
                    <input type="date" name="fromDate" class="form-control" value="@Context.Request.Query["fromDate"]" />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold">To Date</label>
                    <input type="date" name="toDate" class="form-control" value="@Context.Request.Query["toDate"]" />
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search me-1"></i>Filter
                    </button>
                    <a asp-action="CustomerReport" class="btn btn-outline-secondary w-100">
                        <i class="bi bi-x-lg"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Result count -->
    <div class="alert alert-info d-flex align-items-center mb-3 py-2">
        <i class="bi bi-info-circle-fill me-2"></i>
        <strong>@Model.Count()</strong>&nbsp;customer(s) found.
    </div>

    <!-- Table -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-person-x fs-1"></i>
                    <p class="mt-2">No customers match the selected filters.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-bordered align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                <th>Customer Code</th>
                                <th>Customer Name</th>
                                <th>Email</th>
                                <th>Status</th>
                                <th>Company</th>
                                <th>Created Date</th>
                                <th>Assigned To</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{int idx = 1;}
                            @foreach (var c in Model)
                            {
                                string statusBadge = c.Status switch
                                {
                                    "Active" => "bg-success",
                                    "Inactive" => "bg-danger",
                                    "Prospect" => "bg-warning text-dark",
                                    _ => "bg-secondary"
                                };
                                <tr>
                                    <td class="text-muted small">@idx</td>
                                    <td><code>@c.CustomerCode</code></td>
                                    <td><strong>@c.CustomerName</strong></td>
                                    <td>@c.Email</td>
                                    <td><span class="badge @statusBadge">@c.Status</span></td>
                                    <td>@c.CompanyName</td>
                                    <td>@c.CreatedDate.ToString("dd MMM yyyy")</td>
                                    <td>@(c.AssignedTo != null ? c.AssignedTo : "-")</td>
                                </tr>
                                idx++;
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
