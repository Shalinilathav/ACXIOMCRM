@{
    ViewData["Title"] = "User Activity Report";
    var activityData = ViewBag.ActivityData as List<dynamic> ?? new List<dynamic>();
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold text-primary"><i class="bi bi-person-check me-2"></i>User Activity Report</h2>
        <a href="javascript:window.print()" class="btn btn-outline-secondary">
            <i class="bi bi-printer me-1"></i>Print
        </a>
    </div>

    <div class="row g-4 mb-4">
        <!-- Summary Table -->
        <div class="col-md-5">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-primary text-white fw-semibold">
                    <i class="bi bi-table me-2"></i>Actions by User
                </div>
                <div class="card-body p-0">
                    @if (!activityData.Any())
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-1"></i>
                            <p class="mt-2">No activity data available.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-bordered align-middle mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th>#</th>
                                        <th>User Name</th>
                                        <th class="text-center">Total Actions</th>
                                        <th>Share</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int totalActions = activityData.Sum(r => (int)r.Count);
                                        int rank = 1;
                                    }
                                    @foreach (var row in activityData.OrderByDescending(r => (int)r.Count))
                                    {
                                        int count = (int)row.Count;
                                        double pct = totalActions > 0 ? (count * 100.0 / totalActions) : 0;
                                        <tr>
                                            <td class="text-muted small">@rank</td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2"
                                                         style="width:30px;height:30px;font-size:12px;font-weight:bold;">
                                                        @(((string)row.UserName).Substring(0, 1).ToUpper())
                                                    </div>
                                                    @row.UserName
                                                </div>
                                            </td>
                                            <td class="text-center fw-bold">@count</td>
                                            <td style="min-width:100px;">
                                                <div class="progress" style="height:16px;" title="@pct.ToString("F1")%">
                                                    <div class="progress-bar bg-primary" role="progressbar"
                                                         style="width:@pct.ToString("F1")%">
                                                        @pct.ToString("F0")%
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                        rank++;
                                    }
                                    <tr class="table-light fw-bold">
                                        <td colspan="2" class="text-end">Total</td>
                                        <td class="text-center">@totalActions</td>
                                        <td>100%</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Chart -->
        <div class="col-md-7">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-dark text-white fw-semibold">
                    <i class="bi bi-bar-chart-fill me-2"></i>User Activity — Bar Chart
                </div>
                <div class="card-body">
                    <canvas id="userActivityChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        const users = [@Html.Raw(string.Join(",", activityData.Select(r => $"'{r.UserName}'")))];
        const counts = [@Html.Raw(string.Join(",", activityData.Select(r => (int)r.Count)))];

        const colors = [
            'rgba(54, 162, 235, 0.8)',
            'rgba(75, 192, 92, 0.8)',
            'rgba(255, 206, 86, 0.8)',
            'rgba(255, 99, 132, 0.8)',
            'rgba(153, 102, 255, 0.8)',
            'rgba(255, 159, 64, 0.8)',
            'rgba(201, 203, 207, 0.8)',
            'rgba(0, 188, 212, 0.8)',
        ];

        const ctx = document.getElementById('userActivityChart').getContext('2d');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: users,
                datasets: [{
                    label: 'Total Actions',
                    data: counts,
                    backgroundColor: counts.map((_, i) => colors[i % colors.length]),
                    borderColor: counts.map((_, i) => colors[i % colors.length].replace('0.8', '1')),
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { display: false },
                    title: {
                        display: true,
                        text: 'Total Actions per User'
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { precision: 0 }
                    }
                }
            }
        });
    </script>
}
