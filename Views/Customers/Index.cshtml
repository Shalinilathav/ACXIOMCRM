@model IEnumerable<AcxiomCRM.Models.Customer>

@{
    ViewData["Title"] = "Customers";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0"><i class="bi bi-people-fill me-2 text-primary"></i>Customers</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i> Create New Customer
    </a>
</div>

<!-- Search / Filter Form -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2">
            <div class="col-md-2">
                <input type="text" name="customerName" value="@ViewData["customerName"]"
                       class="form-control form-control-sm" placeholder="Customer Name" />
            </div>
            <div class="col-md-2">
                <input type="text" name="email" value="@ViewData["email"]"
                       class="form-control form-control-sm" placeholder="Email" />
            </div>
            <div class="col-md-2">
                <input type="text" name="phone" value="@ViewData["phone"]"
                       class="form-control form-control-sm" placeholder="Phone" />
            </div>
            <div class="col-md-2">
                <input type="text" name="company" value="@ViewData["company"]"
                       class="form-control form-control-sm" placeholder="Company" />
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    <option value="Active" selected="@("Active" == ViewData["status"]?.ToString())">Active</option>
                    <option value="Inactive" selected="@("Inactive" == ViewData["status"]?.ToString())">Inactive</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="bi bi-search me-1"></i> Search
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm w-100">
                    <i class="bi bi-x-circle me-1"></i> Clear
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Row count -->
<div class="d-flex justify-content-between align-items-center mb-2">
    <span class="text-muted small">
        Showing <strong>@Model.Count()</strong> record(s)
    </span>
</div>

@if (!Model.Any())
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-person-x display-1 text-muted"></i>
            <h5 class="mt-3 text-muted">No customers found</h5>
            <p class="text-muted">Try adjusting your search criteria or <a asp-action="Create">create a new customer</a>.</p>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Code</th>
                            <th>Customer Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Company</th>
                            <th>Status</th>
                            <th>Assigned To</th>
                            <th>Created Date</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var customer in Model)
                        {
                            <tr>
                                <td><code>@customer.CustomerCode</code></td>
                                <td>@customer.CustomerName</td>
                                <td>
                                    <a href="mailto:@customer.Email" class="text-decoration-none">@customer.Email</a>
                                </td>
                                <td>@customer.Phone</td>
                                <td>@customer.CompanyName</td>
                                <td>
                                    @if (customer.Status == "Active")
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                </td>
                                <td>@customer.AssignedTo</td>
                                <td>@customer.CreatedDate.ToString("MM/dd/yyyy")</td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Details" asp-route-id="@customer.CustomerId"
                                           class="btn btn-outline-info" title="View">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@customer.CustomerId"
                                           class="btn btn-outline-warning" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" class="btn btn-outline-danger"
                                                title="Delete"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteModal"
                                                data-id="@customer.CustomerId"
                                                data-name="@customer.CustomerName">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Pagination -->
    @if (ViewData["TotalPages"] != null && (int)ViewData["TotalPages"]! > 1)
    {
        int currentPage = (int)(ViewData["CurrentPage"] ?? 1);
        int totalPages = (int)ViewData["TotalPages"]!;
        <nav class="mt-3" aria-label="Customer pagination">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="@(currentPage - 1)"
                       asp-route-customerName="@ViewData["customerName"]"
                       asp-route-email="@ViewData["email"]"
                       asp-route-phone="@ViewData["phone"]"
                       asp-route-company="@ViewData["company"]"
                       asp-route-status="@ViewData["status"]">Previous</a>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@i"
                           asp-route-customerName="@ViewData["customerName"]"
                           asp-route-email="@ViewData["email"]"
                           asp-route-phone="@ViewData["phone"]"
                           asp-route-company="@ViewData["company"]"
                           asp-route-status="@ViewData["status"]">@i</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="@(currentPage + 1)"
                       asp-route-customerName="@ViewData["customerName"]"
                       asp-route-email="@ViewData["email"]"
                       asp-route-phone="@ViewData["phone"]"
                       asp-route-company="@ViewData["company"]"
                       asp-route-status="@ViewData["status"]">Next</a>
                </li>
            </ul>
        </nav>
    }
}

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Delete
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete customer <strong id="deleteCustomerName"></strong>?
                This action cannot be undone.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i> Cancel
                </button>
                <form id="deleteForm" method="post" asp-action="Delete">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="deleteCustomerId" name="id" />
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i> Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var deleteModal = document.getElementById('deleteModal');
        deleteModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var id = button.getAttribute('data-id');
            var name = button.getAttribute('data-name');
            document.getElementById('deleteCustomerId').value = id;
            document.getElementById('deleteCustomerName').textContent = name;
        });
    </script>
}
