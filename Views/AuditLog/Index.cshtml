@model IEnumerable<AcxiomCRM.Models.AuditLog>
@{
    ViewData["Title"] = "Audit Log";
    int pageSize = 20;
    int currentPage = int.TryParse(Context.Request.Query["page"], out int p) ? p : 1;
    int totalRecords = Model.Count();
    int totalPages = (int)Math.Ceiling((double)totalRecords / pageSize);
    var pagedData = Model.Skip((currentPage - 1) * pageSize).Take(pageSize);
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold text-primary"><i class="bi bi-journal-text me-2"></i>Audit Log</h2>
        <span class="text-muted small">Total: @totalRecords record(s)</span>
    </div>

    <!-- Search -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-md-2">
                    <label class="form-label fw-semibold">User</label>
                    <input type="text" name="user" class="form-control" placeholder="Username..."
                           value="@Context.Request.Query["user"]" />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold">Module</label>
                    <input type="text" name="module" class="form-control" placeholder="Entity/Module..."
                           value="@Context.Request.Query["module"]" />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold">Action</label>
                    <input type="text" name="action" class="form-control" placeholder="Action..."
                           value="@Context.Request.Query["action"]" />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold">From Date</label>
                    <input type="date" name="fromDate" class="form-control" value="@Context.Request.Query["fromDate"]" />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold">To Date</label>
                    <input type="date" name="toDate" class="form-control" value="@Context.Request.Query["toDate"]" />
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search me-1"></i>Search
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary w-100">
                        <i class="bi bi-x-lg"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Table -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            @if (!pagedData.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-journal-x fs-1"></i>
                    <p class="mt-2">No audit log entries found.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-sm align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Date/Time</th>
                                <th>User</th>
                                <th>Action</th>
                                <th>Module</th>
                                <th>Record ID</th>
                                <th>Result</th>
                                <th>IP Address</th>
                                <th>Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in pagedData)
                            {
                                string resultBadge = log.Result switch
                                {
                                    "Success" => "bg-success",
                                    "Failed" => "bg-danger",
                                    "LockedOut" => "bg-danger",
                                    _ => "bg-secondary"
                                };
                                <tr>
                                    <td class="text-nowrap small">@log.CreatedDate.ToString("dd MMM yyyy HH:mm")</td>
                                    <td class="small">@log.UserName</td>
                                    <td><span class="badge bg-info text-dark">@log.Action</span></td>
                                    <td class="small">@log.EntityName</td>
                                    <td class="small text-muted">@log.RecordId</td>
                                    <td><span class="badge @resultBadge">@log.Result</span></td>
                                    <td class="small text-muted">@log.IpAddress</td>
                                    <td class="small" style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"
                                        title="@log.Details">
                                        @log.Details
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (totalPages > 1)
                {
                    <nav class="p-3">
                        <ul class="pagination pagination-sm mb-0 justify-content-center">
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-page="@(currentPage - 1)"
                                   asp-route-user="@Context.Request.Query["user"]"
                                   asp-route-module="@Context.Request.Query["module"]"
                                   asp-route-action="@Context.Request.Query["action"]"
                                   asp-route-fromDate="@Context.Request.Query["fromDate"]"
                                   asp-route-toDate="@Context.Request.Query["toDate"]">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>
                            @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Index"
                                       asp-route-page="@i"
                                       asp-route-user="@Context.Request.Query["user"]"
                                       asp-route-module="@Context.Request.Query["module"]"
                                       asp-route-action="@Context.Request.Query["action"]"
                                       asp-route-fromDate="@Context.Request.Query["fromDate"]"
                                       asp-route-toDate="@Context.Request.Query["toDate"]">@i</a>
                                </li>
                            }
                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-page="@(currentPage + 1)"
                                   asp-route-user="@Context.Request.Query["user"]"
                                   asp-route-module="@Context.Request.Query["module"]"
                                   asp-route-action="@Context.Request.Query["action"]"
                                   asp-route-fromDate="@Context.Request.Query["fromDate"]"
                                   asp-route-toDate="@Context.Request.Query["toDate"]">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                        <div class="text-center text-muted small mt-2">
                            Page @currentPage of @totalPages
                        </div>
                    </nav>
                }
            }
        </div>
    </div>
</div>
