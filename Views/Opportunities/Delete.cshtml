@model AcxiomCRM.Models.Opportunity
@{ViewData["Title"] = "Delete Opportunity";}
<div class="container-fluid px-4">
    <div class="d-flex align-items-center mb-3">
        <a asp-action="Index" class="btn btn-outline-secondary me-3"><i class="bi bi-arrow-left"></i></a>
        <h2 class="fw-bold text-danger mb-0"><i class="bi bi-trash me-2"></i>Delete Opportunity</h2>
    </div>
    <div class="card shadow-sm border-danger" style="max-width:600px;">
        <div class="card-body">
            <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i>Are you sure you want to permanently delete this record?</div>
            <dl class="row">
                <dt class="col-sm-4">Name</dt><dd class="col-sm-8">@Model.OpportunityName</dd>
                <dt class="col-sm-4">Stage</dt><dd class="col-sm-8">@Model.Stage</dd>
                <dt class="col-sm-4">Amount</dt><dd class="col-sm-8">@Model.Amount.ToString("N2")</dd>
            </dl>
            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.OpportunityId" />
                <button type="submit" class="btn btn-danger me-2"><i class="bi bi-trash me-1"></i>Yes, Delete</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
