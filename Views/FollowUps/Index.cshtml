@model IEnumerable<AcxiomCRM.Models.FollowUp>
@{
    ViewData["Title"] = "Follow-Ups";
    var today = DateTime.Today;
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold text-primary"><i class="bi bi-alarm me-2"></i>Follow-Ups</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Create Follow-Up
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Search / Filter -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Status</label>
                    <select name="status" class="form-select">
                        <option value="">-- All Statuses --</option>
                        <option value="Planned" selected="@(Context.Request.Query["status"] == "Planned" ? "selected" : null)">Planned</option>
                        <option value="Completed" selected="@(Context.Request.Query["status"] == "Completed" ? "selected" : null)">Completed</option>
                        <option value="Missed" selected="@(Context.Request.Query["status"] == "Missed" ? "selected" : null)">Missed</option>
                        <option value="Cancelled" selected="@(Context.Request.Query["status"] == "Cancelled" ? "selected" : null)">Cancelled</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold">From Date</label>
                    <input type="date" name="fromDate" class="form-control" value="@Context.Request.Query["fromDate"]" />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold">To Date</label>
                    <input type="date" name="toDate" class="form-control" value="@Context.Request.Query["toDate"]" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Assigned To</label>
                    <input type="text" name="assignedUser" class="form-control" placeholder="Search assigned user..."
                           value="@Context.Request.Query["assignedUser"]" />
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search me-1"></i>Search
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary w-100">
                        <i class="bi bi-x-lg"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Table -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox fs-1"></i>
                    <p class="mt-2">No follow-ups found.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Subject</th>
                                <th>Follow-Up Date</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th>Customer</th>
                                <th>Lead</th>
                                <th>Assigned To</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                bool isOverdue = item.FollowUpDate.Date < today && item.Status == "Planned";
                                <tr style="@(isOverdue ? "background-color: #ffe5e5;" : "")">
                                    <td>
                                        @if (isOverdue)
                                        {
                                            <i class="bi bi-exclamation-triangle-fill text-danger me-1" title="Overdue"></i>
                                        }
                                        <strong>@item.Subject</strong>
                                    </td>
                                    <td>
                                        <span class="@(isOverdue ? "text-danger fw-semibold" : "")">
                                            @item.FollowUpDate.ToString("dd MMM yyyy")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-info text-dark">@item.FollowUpType</span>
                                    </td>
                                    <td>
                                        @{
                                            string badgeClass = item.Status switch
                                            {
                                                "Planned" => "bg-primary",
                                                "Completed" => "bg-success",
                                                "Missed" => "bg-danger",
                                                "Cancelled" => "bg-secondary",
                                                _ => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @badgeClass">@item.Status</span>
                                    </td>
                                    <td>@(item.Customer != null ? item.Customer.CustomerName : "-")</td>
                                    <td>@(item.Lead != null ? item.Lead.LeadName : "-")</td>
                                    <td>@(item.AssignedTo != null ? item.AssignedTo : "-")</td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-1 flex-wrap">
                                            <a asp-action="Details" asp-route-id="@item.FollowUpId"
                                               class="btn btn-sm btn-outline-info" title="Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.FollowUpId"
                                               class="btn btn-sm btn-outline-warning" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            @if (item.Status == "Planned")
                                            {
                                                <form asp-action="Complete" asp-route-id="@item.FollowUpId" method="post"
                                                      onsubmit="return confirm('Mark this follow-up as Completed?')">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-success" title="Complete">
                                                        <i class="bi bi-check-circle"></i>
                                                    </button>
                                                </form>
                                            }
                                            <form asp-action="Delete" asp-route-id="@item.FollowUpId" method="post"
                                                  onsubmit="return confirm('Are you sure you want to delete this follow-up?')">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="p-3 text-muted small">
                    Showing @Model.Count() record(s)
                    @{
                        int overdueCount = Model.Count(f => f.FollowUpDate.Date < today && f.Status == "Planned");
                    }
                    @if (overdueCount > 0)
                    {
                        <span class="text-danger fw-semibold ms-2">
                            <i class="bi bi-exclamation-triangle-fill"></i> @overdueCount overdue
                        </span>
                    }
                </div>
            }
        </div>
    </div>
</div>
