@model AcxiomCRM.Models.FollowUp
@{
    ViewData["Title"] = "Follow-Up Details";
    string badgeClass = Model.Status switch
    {
        "Planned" => "bg-primary",
        "Completed" => "bg-success",
        "Missed" => "bg-danger",
        "Cancelled" => "bg-secondary",
        _ => "bg-secondary"
    };
}

<div class="container-fluid px-4">
    <div class="d-flex align-items-center mb-3">
        <a asp-action="Index" class="btn btn-outline-secondary me-3">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h2 class="fw-bold text-info mb-0"><i class="bi bi-alarm me-2"></i>Follow-Up Details</h2>
    </div>

    <div class="card shadow-sm" style="max-width: 750px;">
        <div class="card-header d-flex justify-content-between align-items-center bg-light">
            <h5 class="mb-0">@Model.Subject</h5>
            <span class="badge @badgeClass fs-6">@Model.Status</span>
        </div>
        <div class="card-body">
            <div class="row g-4">
                <div class="col-md-6">
                    <label class="form-label text-muted small fw-semibold text-uppercase">Follow-Up Date</label>
                    <p class="fs-6 fw-semibold @(Model.FollowUpDate.Date < DateTime.Today && Model.Status == "Planned" ? "text-danger" : "")">
                        @Model.FollowUpDate.ToString("dd MMM yyyy")
                        @if (Model.FollowUpDate.Date < DateTime.Today && Model.Status == "Planned")
                        {
                            <span class="badge bg-danger ms-1">Overdue</span>
                        }
                    </p>
                </div>
                <div class="col-md-6">
                    <label class="form-label text-muted small fw-semibold text-uppercase">Follow-Up Type</label>
                    <p><span class="badge bg-info text-dark fs-6">@Model.FollowUpType</span></p>
                </div>
                <div class="col-12">
                    <label class="form-label text-muted small fw-semibold text-uppercase">Subject</label>
                    <p class="fs-6">@Model.Subject</p>
                </div>
                <div class="col-md-6">
                    <label class="form-label text-muted small fw-semibold text-uppercase">Status</label>
                    <p><span class="badge @badgeClass fs-6">@Model.Status</span></p>
                </div>
                <div class="col-md-6">
                    <label class="form-label text-muted small fw-semibold text-uppercase">Assigned To</label>
                    <p class="fs-6">@(Model.AssignedTo != null ? Model.AssignedTo : "-")</p>
                </div>
                <div class="col-md-6">
                    <label class="form-label text-muted small fw-semibold text-uppercase">Customer</label>
                    <p class="fs-6">@(Model.Customer != null ? Model.Customer.CustomerName : "-")</p>
                </div>
                <div class="col-md-6">
                    <label class="form-label text-muted small fw-semibold text-uppercase">Lead</label>
                    <p class="fs-6">@(Model.Lead != null ? Model.Lead.LeadName : "-")</p>
                </div>
                <div class="col-12">
                    <label class="form-label text-muted small fw-semibold text-uppercase">Remarks</label>
                    <p class="fs-6 border rounded p-2 bg-light">@(string.IsNullOrWhiteSpace(Model.Remarks) ? "No remarks." : Model.Remarks)</p>
                </div>
                <div class="col-md-6">
                    <label class="form-label text-muted small fw-semibold text-uppercase">Created Date</label>
                    <p class="fs-6 text-muted">@Model.CreatedDate.ToString("dd MMM yyyy hh:mm tt")</p>
                </div>
                {
                    <div class="col-md-6">
                        <label class="form-label text-muted small fw-semibold text-uppercase">Last Modified</label>
                    </div>
                }
            </div>
        </div>
        <div class="card-footer d-flex gap-2 bg-light">
            <a asp-action="Edit" asp-route-id="@Model.FollowUpId" class="btn btn-warning">
                <i class="bi bi-pencil me-1"></i>Edit
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Back to List
            </a>
        </div>
    </div>
</div>
