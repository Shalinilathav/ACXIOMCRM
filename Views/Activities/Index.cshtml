@model IEnumerable<AcxiomCRM.Models.Activity>
@{
    ViewData["Title"] = "Activities";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold text-primary"><i class="bi bi-activity me-2"></i>Activities</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Log Activity
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Search -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Activity Type</label>
                    <select name="activityType" class="form-select">
                        <option value="">-- All Types --</option>
                        <option value="Call" selected="@(Context.Request.Query["activityType"] == "Call" ? "selected" : null)">Call</option>
                        <option value="Email" selected="@(Context.Request.Query["activityType"] == "Email" ? "selected" : null)">Email</option>
                        <option value="Meeting" selected="@(Context.Request.Query["activityType"] == "Meeting" ? "selected" : null)">Meeting</option>
                        <option value="Task" selected="@(Context.Request.Query["activityType"] == "Task" ? "selected" : null)">Task</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold">Status</label>
                    <select name="status" class="form-select">
                        <option value="">-- All --</option>
                        <option value="Open" selected="@(Context.Request.Query["status"] == "Open" ? "selected" : null)">Open</option>
                        <option value="Completed" selected="@(Context.Request.Query["status"] == "Completed" ? "selected" : null)">Completed</option>
                        <option value="Cancelled" selected="@(Context.Request.Query["status"] == "Cancelled" ? "selected" : null)">Cancelled</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold">From Date</label>
                    <input type="date" name="fromDate" class="form-control" value="@Context.Request.Query["fromDate"]" />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold">To Date</label>
                    <input type="date" name="toDate" class="form-control" value="@Context.Request.Query["toDate"]" />
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search me-1"></i>Search
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary w-100">
                        <i class="bi bi-x-lg"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Table -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox fs-1"></i>
                    <p class="mt-2">No activities found.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Type</th>
                                <th>Subject</th>
                                <th>Activity Date</th>
                                <th>Customer</th>
                                <th>Lead</th>
                                <th>Assigned To</th>
                                <th>Status</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                string typeBadge = item.ActivityType switch
                                {
                                    "Call" => "bg-success",
                                    "Email" => "bg-info text-dark",
                                    "Meeting" => "bg-warning text-dark",
                                    "Task" => "bg-secondary",
                                    _ => "bg-secondary"
                                };
                                string statusBadge = item.Status switch
                                {
                                    "Open" => "bg-primary",
                                    "Completed" => "bg-success",
                                    "Cancelled" => "bg-secondary",
                                    _ => "bg-secondary"
                                };
                                <tr>
                                    <td><span class="badge @typeBadge">@item.ActivityType</span></td>
                                    <td><strong>@item.Subject</strong></td>
                                    <td>@item.ActivityDate.ToString("dd MMM yyyy")</td>
                                    <td>@(item.Customer != null ? item.Customer.CustomerName : "-")</td>
                                    <td>@(item.Lead != null ? item.Lead.LeadName : "-")</td>
                                    <td>@(item.AssignedTo ?? "-")</td>
                                    <td><span class="badge @statusBadge">@item.Status</span></td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-1">
                                            <a asp-action="Details" asp-route-id="@item.ActivityId"
                                               class="btn btn-sm btn-outline-info" title="Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.ActivityId"
                                               class="btn btn-sm btn-outline-warning" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@item.ActivityId" method="post"
                                                  onsubmit="return confirm('Delete this activity?')">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="p-3 text-muted small">Showing @Model.Count() record(s)</div>
            }
        </div>
    </div>
</div>
