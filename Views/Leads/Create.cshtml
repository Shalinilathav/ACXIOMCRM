@model AcxiomCRM.Models.Lead
@{
    ViewData["Title"] = "Create Lead";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-bullseye text-success me-2"></i>Create Lead</h2>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a>
</div>
<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="LeadName" class="form-label fw-semibold"></label>
                    <input asp-for="LeadName" class="form-control" maxlength="100" placeholder="Full name of lead contact" />
                    <span asp-validation-for="LeadName" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Email" class="form-label fw-semibold"></label>
                    <input asp-for="Email" class="form-control" type="email" maxlength="150" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Phone" class="form-label fw-semibold"></label>
                    <input asp-for="Phone" class="form-control" maxlength="15"
                           data-val="true"
                           data-val-regex="Enter a valid 10-digit phone number."
                           data-val-regex-pattern="^[6-9]\d{9}$" />
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="CompanyName" class="form-label fw-semibold"></label>
                    <input asp-for="CompanyName" class="form-control" maxlength="150" />
                    <span asp-validation-for="CompanyName" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Source" class="form-label fw-semibold"></label>
                    <select asp-for="Source" class="form-select">
                        <option value="">-- Select Source --</option>
                        <option>Website</option>
                        <option>Referral</option>
                        <option>Email Campaign</option>
                        <option>Phone</option>
                        <option>Social Media</option>
                        <option>Trade Show</option>
                        <option>Other</option>
                    </select>
                    <span asp-validation-for="Source" class="text-danger small"></span>
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="Status" class="form-label fw-semibold"></label>
                    <select asp-for="Status" class="form-select">
                        <option value="New">New</option>
                        <option value="Contacted">Contacted</option>
                        <option value="Qualified">Qualified</option>
                        <option value="Unqualified">Unqualified</option>
                        <option value="Lost">Lost</option>
                    </select>
                    <span asp-validation-for="Status" class="text-danger small"></span>
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="Priority" class="form-label fw-semibold"></label>
                    <select asp-for="Priority" class="form-select">
                        <option value="High">High</option>
                        <option value="Medium" selected>Medium</option>
                        <option value="Low">Low</option>
                    </select>
                    <span asp-validation-for="Priority" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="ExpectedValue" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text">₹</span>
                        <input asp-for="ExpectedValue" class="form-control" type="number" min="0" step="0.01" />
                    </div>
                    <span asp-validation-for="ExpectedValue" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">Assigned To</label>
                    <select asp-for="AssignedTo" class="form-select" asp-items="@(ViewData["AssignedToList"] as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)">
                        <option value="">-- Select User --</option>
                    </select>
                </div>
                <div class="col-12 mb-3">
                    <label asp-for="Notes" class="form-label fw-semibold"></label>
                    <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Additional notes..."></textarea>
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success"><i class="fas fa-save me-1"></i>Create Lead</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
